---
import type { Props } from './dist/utils'
import { generateFonts, getPreloadType, createPreloads, createBaseCSS, createFontCSS } from './dist/utils'

const { config } = Astro.props as Props

const resolvedConfig = await generateFonts(config)

const preloads = resolvedConfig.flatMap(createPreloads)
const styles = (
  await Promise.all([...resolvedConfig.map(createBaseCSS), ...resolvedConfig.map(createFontCSS)])
).flat().join(' ')
---

{preloads.map((content) => <link as="font" crossorigin rel="preload" href={content} type={getPreloadType(content)} />)}
<style set:html={styles} is:inline />
